# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
.pnpm-store/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
# Sibling dist directories used by additional build targets — packages/ui's
# embedded chat bundle (vite.embedded.config.ts → dist-embedded/) and
# packages/vscode's @vscode/test-electron runner (tsup.e2e.config.ts →
# dist-e2e/). Both are regenerable build outputs, same status as `dist/`.
dist-embedded
dist-e2e

# Node-only distributable produced by scripts/build-node-bundle.mjs
# (self-contained CLI + daemon + UI tree + tarball). Regenerable; never committed.
/release/

# Native engine binaries — produced by native/engines/*/build.sh (local) or
# downloaded from a `native-vX.Y.Z` GitHub Release (CI). Never committed.
packages/app/native-bin/
packages/app/.playwright-mcp/*.yml

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Playwright test screenshots
packages/app/screenshots/

# Browser UX suite — regenerated screenshot gallery + manifest (run `pnpm test:e2e:web`)
packages/app/ux-screenshots/

# Playwright test artifacts (per-run, not team-shared)
test-results/
playwright-report/

# Claude Code local session state (per-developer, not team-shared)
.claude/*
# …except team-shared skills under .claude/skills/
!.claude/skills/

# Spike / evaluation scratchpad — never committed.
.spike/

# Scratch/output dirs — gallery screenshots, ad-hoc test artifacts, etc.
tmp/
temp/

.DS_Store

# Architecture/quality review reports — local artifacts
reports/
/reports
/artifacts/

# Catalog importer cache and per-run diagnostics (never team-shared).
# `.import-state/` retains only the slug map + watermark; those keep
# incremental imports and assigned catalog ids stable across machines.
packages/catalog/scripts/.import-cache/
packages/catalog/scripts/.import-state/runs/
packages/eval-viewer/src/data/runs-index.json

# Derived catalog indexes: regenerated by `build-index` (runs as part of the
# catalog `build`) from the committed per-item manifest folders, which are the
# source of truth. Runtime falls back to a disk walk when absent (see
# source.ts listFromIndex → listFromDisk). Not team-shared — committing the
# 1MB+ blobs only produces merge conflicts in files no human edits.
packages/catalog/data/*/index.json
packages/catalog/data/community/*/index.json

# Python bytecode
__pycache__/
*.pyc
/runs
/runs
packages/catalog/scripts/harvested-auth/
