{
  "name": "gezel",
  "version": "0.0.0",
  "private": true,
  "description": "Build a crew of named AI companions with distinct roles and tools, then put them to work on your projects. Gezel stores their conversations, memory, and work on your computer as ordinary files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "pnpm:devPreinstall": "node scripts/guard-pnpm-install.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/run-with-dependency-lease.mjs build:unleased",
    "build:unleased": "pnpm bootstrap && pnpm run build:packages",
    "build:packages": "node scripts/run-with-dependency-lease.mjs build:packages:unleased",
    "build:packages:unleased": "pnpm --filter @bendyline/gezk run build && pnpm --filter @bendyline/gezel run build && pnpm -r --filter @bendyline/gezel-client --filter @bendyline/gezel-plugin-sdk --filter @bendyline/gezel-sdk --filter @bendyline/gezel-app-sdk --filter @bendyline/gezel-catalog --filter @bendyline/gezel-knowledge --filter @bendyline/gezel-connectors-spectral run build && pnpm --filter @bendyline/gezel-mcp run build && pnpm --filter @bendyline/gezel-ui run build:all && pnpm --filter @bendyline/gezel-service run build && pnpm -r --filter @bendyline/gezel-cli --filter @bendyline/gezel-app --filter @bendyline/gezel-vscode run build",
    "build:bundle": "node scripts/run-with-dependency-lease.mjs build:bundle:unleased",
    "build:bundle:unleased": "pnpm --filter @bendyline/gezel-app run build:bundle",
    "build:node-bundle": "node scripts/run-with-dependency-lease.mjs build:node-bundle:unleased",
    "build:node-bundle:unleased": "pnpm build && node scripts/build-node-bundle.mjs",
    "build:packaged": "node scripts/run-with-dependency-lease.mjs build:packaged:unleased",
    "build:packaged:unleased": "pnpm build && pnpm stage:licenses && pnpm build:bundle",
    "package": "node scripts/run-with-dependency-lease.mjs package:unleased",
    "package:unleased": "pnpm build && pnpm --filter @bendyline/gezel-app run package",
    "package:mac": "node scripts/run-with-dependency-lease.mjs package:mac:unleased",
    "package:mac:unleased": "pnpm build && pnpm --filter @bendyline/gezel-app run package:mac",
    "package:win": "node scripts/run-with-dependency-lease.mjs package:win:unleased",
    "package:win:unleased": "pnpm build && pnpm --filter @bendyline/gezel-app run package:win",
    "package:linux": "node scripts/run-with-dependency-lease.mjs package:linux:unleased",
    "package:linux:unleased": "pnpm build && pnpm --filter @bendyline/gezel-app run package:linux",
    "rebuild": "pnpm clean && pnpm build",
    "deps:rebuild": "pnpm clean && pnpm deps:repair && pnpm build",
    "dev": "node scripts/run-with-dependency-lease.mjs dev:unleased",
    "dev:unleased": "pnpm bootstrap && pnpm -r --filter \"@bendyline/gezel*\" --filter \"@bendyline/gezk*\" --filter \"!@bendyline/squisq*\" --parallel run dev",
    "app": "node scripts/run-with-dependency-lease.mjs app:unleased",
    "app:unleased": "node scripts/dev-fresh-runtime.mjs && pnpm build && pnpm --filter @bendyline/gezel-app exec electron . --no-sandbox",
    "app:clean": "node scripts/run-with-dependency-lease.mjs app:clean:unleased",
    "app:clean:unleased": "node scripts/dev-fresh-runtime.mjs && pnpm rebuild && pnpm --filter @bendyline/gezel-app exec electron . --no-sandbox",
    "cli": "node scripts/run-with-dependency-lease.mjs cli:unleased",
    "cli:unleased": "pnpm bootstrap && pnpm --filter @bendyline/gezel-cli... run build && GEZEL_DEV=1 node packages/cli/dist/bin/gezel.js",
    "cli:fresh": "node scripts/run-with-dependency-lease.mjs cli:fresh:unleased",
    "cli:fresh:unleased": "pnpm --filter @bendyline/gezel-cli run build && GEZEL_DEV=1 node packages/cli/dist/bin/gezel.js",
    "cli:tui": "node scripts/run-with-dependency-lease.mjs cli:tui:unleased",
    "cli:tui:unleased": "pnpm bootstrap && pnpm --filter @bendyline/gezel-cli... run build && node scripts/run-cli-tui.mjs",
    "test": "node scripts/run-with-dependency-lease.mjs test:unleased",
    "test:unleased": "pnpm -r --filter \"@bendyline/gezel*\" --filter \"@bendyline/gezk*\" run test",
    "test:ci": "node scripts/run-with-dependency-lease.mjs test:ci:unleased",
    "test:ci:unleased": "pnpm -r --workspace-concurrency=1 --filter \"@bendyline/gezel*\" --filter \"@bendyline/gezk*\" run test",
    "test:stability": "node scripts/run-with-dependency-lease.mjs test:stability:unleased",
    "test:stability:unleased": "pnpm -r --workspace-concurrency=1 --filter @bendyline/gezel-ui --filter @bendyline/gezel-service run test && pnpm test:stability:tui && pnpm -r --workspace-concurrency=1 --filter @bendyline/gezel-ui --filter @bendyline/gezel-service run test && pnpm test:stability:tui",
    "test:stability:tui": "node scripts/run-with-dependency-lease.mjs test:stability:tui:unleased",
    "test:stability:tui:unleased": "pnpm --filter @bendyline/gezel-cli exec vitest run src/tui/App.test.tsx",
    "test:extended": "node scripts/run-with-dependency-lease.mjs test:extended:unleased",
    "test:extended:unleased": "pnpm --filter @bendyline/gezel-service exec tsx src/chat/prompt-tool-contract-matrix.ts",
    "test:surface": "node scripts/run-with-dependency-lease.mjs test:surface:unleased",
    "test:surface:unleased": "node --test scripts/check-test-surface.test.mjs && node scripts/check-test-surface.mjs --json artifacts/test-surface-coverage.json",
    "test:coverage": "node scripts/run-with-dependency-lease.mjs test:coverage:unleased",
    "test:coverage:unleased": "node --test scripts/run-vitest-coverage.test.mjs && node scripts/run-vitest-coverage.mjs",
    "test:ui-startup-budget": "node --test scripts/check-ui-startup-budget.test.mjs",
    "test:published": "node scripts/run-with-dependency-lease.mjs test:published:unleased",
    "test:published:unleased": "vitest run --config vitest.published.config.ts",
    "check:packages": "node scripts/check-package-consumers.mjs",
    "check:npm-release-candidate": "pnpm build && node scripts/rehearse-npm-release.mjs",
    "check:release-toolchain": "node scripts/check-release-toolchain.mjs",
    "check:workspace-deps": "node scripts/check-workspace-dependencies.mjs",
    "release": "multi-semantic-release",
    "pw:install": "node scripts/run-with-dependency-lease.mjs pw:install:unleased",
    "pw:install:unleased": "pnpm --filter @bendyline/gezel-app exec playwright install chromium",
    "test:e2e:run": "node scripts/run-with-dependency-lease.mjs test:e2e:run:unleased",
    "test:e2e:run:unleased": "pnpm --filter @bendyline/gezel-app run test:e2e",
    "test:e2e:desktop:smoke": "node scripts/run-with-dependency-lease.mjs test:e2e:desktop:smoke:unleased",
    "test:e2e:desktop:smoke:unleased": "pnpm --filter @bendyline/gezel-app exec playwright test app.spec.ts supervisor-spawn.spec.ts --reporter=line --retries=0 --workers=1",
    "test:e2e": "node scripts/run-with-dependency-lease.mjs test:e2e:unleased",
    "test:e2e:unleased": "pnpm build && pnpm test:e2e:run",
    "test:e2e:web:run": "node scripts/run-with-dependency-lease.mjs test:e2e:web:run:unleased",
    "test:e2e:web:run:unleased": "pnpm --filter @bendyline/gezel-app run test:e2e:web",
    "test:e2e:web:smoke": "node scripts/run-with-dependency-lease.mjs test:e2e:web:smoke:unleased",
    "test:e2e:web:smoke:unleased": "pnpm --filter @bendyline/gezel-app exec playwright test --config playwright.web.config.ts shell.spec.ts write-flow.spec.ts --reporter=line --retries=0 --repeat-each=3 --workers=1",
    "pretest:e2e:web": "node scripts/run-with-dependency-lease.mjs pw:install:unleased",
    "test:e2e:web": "node scripts/run-with-dependency-lease.mjs test:e2e:web:unleased",
    "test:e2e:web:unleased": "pnpm build && pnpm test:e2e:web:run",
    "eval:run": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/run.ts",
    "eval:run:unleased": "pnpm --filter @bendyline/gezel-evals run run",
    "eval:batch": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/batch.ts",
    "eval:batch:unleased": "pnpm --filter @bendyline/gezel-evals run batch",
    "eval:all": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/all.ts",
    "eval:all:unleased": "pnpm --filter @bendyline/gezel-evals run all",
    "eval:ab-reasoning": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/ab-reasoning-factorial.ts",
    "eval:ab-reasoning:unleased": "pnpm --filter @bendyline/gezel-evals run ab-reasoning-factorial",
    "eval:ab-effort": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/ab-reasoning-effort.ts",
    "eval:ab-band-prefix": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/ab-band-prefix.ts",
    "eval:ab-effort:unleased": "pnpm --filter @bendyline/gezel-evals run ab-reasoning-effort",
    "eval:scorecard": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/scorecard.ts",
    "eval:scorecard:unleased": "pnpm --filter @bendyline/gezel-evals run scorecard",
    "eval:judge-sweep": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/judge-sweep.ts",
    "eval:judge-sweep:unleased": "pnpm --filter @bendyline/gezel-evals run judge-sweep",
    "eval:postmortems": "node scripts/run-with-dependency-lease.mjs --direct-node evals/src/bin/render-postmortems.ts",
    "eval:postmortems:unleased": "pnpm --filter @bendyline/gezel-evals run postmortems",
    "eval:viewer": "node scripts/run-with-dependency-lease.mjs eval:viewer:unleased",
    "eval:viewer:unleased": "pnpm --filter @bendyline/gezel-eval-viewer run dev",
    "eval:viewer:build": "node scripts/run-with-dependency-lease.mjs eval:viewer:build:unleased",
    "eval:viewer:build:unleased": "pnpm --filter @bendyline/gezel-eval-viewer run build",
    "validate": "node scripts/validate-workspace.mjs",
    "validate:unlocked": "pnpm check:local-links && pnpm check:workspace-deps && pnpm build && pnpm verify:npm-licenses && pnpm typecheck && pnpm lint && pnpm lint:tool-names && pnpm lint:prompts && pnpm test:ci && pnpm test:stability && pnpm test:surface && pnpm test:published && pnpm check:packages && pnpm test:e2e:run && pnpm test:e2e:desktop:smoke && pnpm pw:install && pnpm test:e2e:web:run && pnpm test:e2e:web:smoke && pnpm build:bundle",
    "all": "node scripts/validate-workspace.mjs",
    "deps:validate": "node scripts/validate-workspace.mjs --install",
    "typecheck": "node scripts/run-with-dependency-lease.mjs typecheck:unleased",
    "typecheck:unleased": "pnpm -r --filter \"@bendyline/gezel*\" --filter \"@bendyline/gezk*\" run typecheck",
    "audit:lockfile": "node scripts/audit-lockfile.mjs",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "docs:site": "node --test scripts/latest-app-release.test.mjs && node scripts/export-handboek-site.mjs",
    "docs:releases": "node --test scripts/latest-app-release.test.mjs && node scripts/latest-app-release.mjs",
    "docs:og-headlines": "node scripts/distill-og-headlines.mjs",
    "check:notice": "node scripts/check-notice.mjs",
    "stage:licenses": "node scripts/stage-third-party-licenses.mjs",
    "verify:licenses": "node scripts/verify-packaged-licenses.mjs packages/app/dist/licenses && pnpm verify:npm-licenses",
    "verify:npm-licenses": "node scripts/verify-service-package-licenses.mjs && node scripts/verify-connectors-spectral-package-licenses.mjs",
    "audit:sbom": "node scripts/generate-sbom.mjs",
    "audit:vulnerabilities": "node scripts/audit-vulnerabilities.mjs",
    "setup": "node scripts/setup.mjs",
    "fetch:native": "node scripts/fetch-native-binaries.mjs",
    "check:workflows": "node scripts/check-workflow-action-pins.mjs",
    "check:local-links": "node scripts/check-no-local-links.mjs",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "link:squisq": "node scripts/squisq-link.mjs link",
    "unlink:squisq": "node scripts/squisq-link.mjs unlink",
    "link:gilde": "node scripts/gilde-link.mjs link",
    "unlink:gilde": "node scripts/gilde-link.mjs unlink",
    "gilde:update": "node scripts/update-gilde.mjs",
    "deps:status": "node scripts/pnpm-install.mjs --status",
    "deps:install": "node scripts/pnpm-install.mjs",
    "deps:repair": "node scripts/pnpm-install.mjs --repair",
    "gilde:export-schemas": "pnpm --filter @bendyline/gezel-catalog run export-gilde-schemas",
    "gilde:import-mcp": "pnpm --filter @bendyline/gezel-catalog run import-mcp-registry",
    "lint": "node scripts/run-with-dependency-lease.mjs lint:unleased",
    "lint:unleased": "biome check . && pnpm check:workflows && node scripts/check-markdown-links.mjs && node scripts/check-notice.mjs && node scripts/check-path-safety.mjs && node --test scripts/check-module-size.test.mjs && node scripts/check-module-size.mjs && node --test scripts/check-ui-startup-budget.test.mjs && node scripts/check-provider-default.mjs && node --test scripts/check-layer-direction.test.mjs && node scripts/check-layer-direction.mjs && node scripts/check-single-owner-symbols.mjs && node scripts/check-patient-fetch.mjs",
    "lint:paths": "node scripts/check-path-safety.mjs",
    "lint:module-size": "node --test scripts/check-module-size.test.mjs && node scripts/check-module-size.mjs",
    "lint:layer-direction": "node --test scripts/check-layer-direction.test.mjs && node scripts/check-layer-direction.mjs",
    "lint:single-owner": "node scripts/check-single-owner-symbols.mjs",
    "lint:patient-fetch": "node scripts/check-patient-fetch.mjs",
    "lint:tool-names": "pnpm --filter @bendyline/gezel-service exec tsx src/chat/model-tool-name-contract.ts",
    "lint:prompts": "pnpm test:extended",
    "lint:fix": "node scripts/run-with-dependency-lease.mjs lint:fix:unleased",
    "lint:fix:unleased": "biome check --write .",
    "format": "node scripts/run-with-dependency-lease.mjs format:unleased",
    "format:unleased": "biome format --write .",
    "clean": "node scripts/run-with-dependency-lease.mjs clean:unleased",
    "clean:unleased": "pnpm -r --filter \"@bendyline/gezel*\" --filter \"@bendyline/gezk*\" run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "multi-semantic-release": "3.1.0",
    "semantic-release": "25.0.8",
    "tar": "7.5.21",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {}
}
