+/* Non-blocking half-close probe.  A streaming client that aborted its fetch
+ * sends a FIN; recv then reports EOF (0) or ECONNRESET.  We only PEEK, so no
+ * request bytes are consumed.  EAGAIN/EWOULDBLOCK means the peer is still
+ * attached and waiting for its response. */
+static bool socket_peer_closed(int fd) {
+    if (fd < 0) return false;
+    char probe;
+    for (;;) {
+        ssize_t n = recv(fd, &probe, 1, MSG_PEEK | MSG_DONTWAIT);
+        if (n == 0) return true;
+        if (n > 0) return false;
+        if (errno == EINTR) continue;
+        if (errno == ECONNRESET || errno == ENOTCONN || errno == EPIPE) return true;
+        return false;
+    }
+}
+
+/* Cooperative-cancel hook armed on the session during prefill.
+ * ds4_session_sync() polls this at safe chunk boundaries; returning true
+ * unwinds prefill with DS4_SESSION_SYNC_INTERRUPTED instead of grinding a full
+ * prompt whose caller has already disconnected.  Without this, a cancelled turn
+ * kept the engine busy for the whole prefill (~150s on a large SSD-streamed
+ * prompt), blocking the next turn behind a zombie. */
+static bool server_prefill_cancel_cb(void *ud) {
+    server_prefill_progress *p = ud;
+    if (!p) return false;
+    if (p->stream_failed) return true;
+    if (p->stream && socket_peer_closed(p->fd)) {
+        p->stream_failed = true;
+        return true;
+    }
+    return false;
+}
