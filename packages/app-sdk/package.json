{
  "name": "@bendyline/gezel-app-sdk",
  "version": "0.0.0",
  "description": "Public SDK for building third-party local apps against gezel \u2014 discovery, consent, OpenAI-shaped chat, ensure-model.",
  "license": "MIT",
  "keywords": ["gezel", "ai", "agents", "local-first", "sdk", "embedding"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/app-sdk"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist", "!dist/**/*.map"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "undici": "8.8.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
