{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendyline.com/gezk/0.8/schemas/radius-query.schema.json",
  "type": "object",
  "properties": {
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "radiusMeters": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "latitude",
    "longitude",
    "radiusMeters"
  ],
  "additionalProperties": false
}
