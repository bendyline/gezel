{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendyline.com/gezk/0.8/schemas/catalog-document.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "topicPath": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
      }
    },
    "tocReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topicPath": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
            }
          },
          "ordinal": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "required": [
          "topicPath"
        ],
        "additionalProperties": false
      }
    },
    "markdown": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string"
    },
    "sourceUpdatedAt": {
      "type": "string"
    },
    "attribution": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ordinal": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "locations": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "role": {
            "type": "string",
            "enum": [
              "subject",
              "associated"
            ]
          },
          "provenance": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "latitude",
          "longitude",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "slug",
    "language",
    "topicPath",
    "markdown"
  ]
}
