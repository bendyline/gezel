{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendyline.com/gezk/0.8/schemas/chunking-profile.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "enum": [
        "tokens",
        "chars"
      ]
    },
    "tokenizer": {
      "type": "string",
      "enum": [
        "profile",
        "none"
      ]
    },
    "target": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "overlap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contextHeader": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max"
      ]
    }
  },
  "required": [
    "id",
    "unit",
    "tokenizer",
    "target",
    "overlap",
    "contextHeader"
  ]
}
