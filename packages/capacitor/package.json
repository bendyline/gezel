{
  "name": "@bendyline/gezel-capacitor",
  "version": "0.1.0",
  "private": true,
  "description": "On-device Gezel App SDK transport and native host for Capacitor.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./packaging": {
      "types": "./scripts/embedding-package.d.mts",
      "import": "./scripts/embedding-package.mjs"
    }
  },
  "files": [
    "dist",
    "kokoro-lexicon",
    "ios/Sources",
    "android/src",
    "android/build.gradle",
    "native",
    "Package.swift",
    "README.md",
    "LICENSE",
    "!native/**/.build/**",
    "!native/**/.swiftpm/**",
    "scripts/embedding-package.mjs",
    "scripts/embedding-package.d.mts",
    "scripts/stage-native.mjs",
    "embedding-manifest.json"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup && node scripts/build-knowledge-worker.mjs && node scripts/copy-web-assets.mjs && node scripts/stage-bundled-licenses.mjs",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "stage:native": "node scripts/stage-native.mjs",
    "prepack": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@bendyline/gezel": "workspace:*",
    "@bendyline/gezel-app-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@bendyline/gezel-inference": "workspace:*",
    "@capacitor/core": "8.5.2",
    "@huggingface/tokenizers": "0.2.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "brotli": "1.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
