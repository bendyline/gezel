<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="GezelDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Gezel</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>GezelDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>%origin%/icons/gezel_26.png</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">WriterVariants, any, visible ;Calc, any, visible ;Impress, any, visible ;</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="GezelPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Gezel</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>GezelPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>GezelDeck</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">WriterVariants, any, visible ;Calc, any, visible ;Impress, any, visible ;</value></prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/GezelPanelFactory/GezelPanel</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
        <prop oor:name="WantsCanvas" oor:type="xs:boolean"><value>false</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
