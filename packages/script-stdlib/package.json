{
  "name": "@bendyline/gezel-script-stdlib",
  "version": "1.1.9",
  "description": "Gezel's standard script library: trusted, read-only scripts that check and support craftbook steps.",
  "license": "MIT",
  "keywords": ["gezel", "ai", "agents", "local-first", "scripts", "stdlib"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/script-stdlib"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./scripts/*": "./scripts/*"
  },
  "files": ["scripts", "!scripts/**/*.test.ts"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/clean-dirs.mjs .turbo"
  },
  "dependencies": {
    "@bendyline/gezel-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
