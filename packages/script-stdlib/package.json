{
  "name": "@bendyline/gezel-script-stdlib",
  "version": "0.1.0",
  "description": "Standard gate-script library packed into the app. Plain defineScript sources resolved in place by the script runner (scope: 'standard'); read-only, trusted, versioned with the app.",
  "license": "MIT",
  "keywords": ["gezel", "ai", "agents", "local-first", "scripts", "stdlib"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/script-stdlib"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./scripts/*": "./scripts/*"
  },
  "files": ["scripts"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo"
  },
  "devDependencies": {
    "@bendyline/gezel-sdk": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
