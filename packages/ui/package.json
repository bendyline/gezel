{
  "name": "@bendyline/gezel-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Gezel web UI (React + Vite). Served by the daemon and bundled into the Electron app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && node ../../scripts/check-ui-startup-budget.mjs dist/index.html",
    "build:embedded": "vite build --config vite.embedded.config.ts",
    "build:all": "vite build && node ../../scripts/check-ui-startup-budget.mjs dist/index.html && vite build --config vite.embedded.config.ts",
    "dev": "vite",
    "poppetje:gallery": "tsx scripts/poppetje-gallery.tsx",
    "poppetje:eval": "tsx scripts/poppetje-eval.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist dist-embedded .turbo"
  },
  "dependencies": {
    "@bendyline/gezel": "workspace:*",
    "@bendyline/gezel-client": "workspace:*",
    "@bendyline/squisq": "2.10.0",
    "@bendyline/squisq-editor-react": "2.10.0",
    "@bendyline/squisq-formats": "2.5.0",
    "@bendyline/squisq-react": "2.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "harper.js": "2.7.0",
    "monaco-editor": "~0.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
