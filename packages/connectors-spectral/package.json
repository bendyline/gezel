{
  "name": "@bendyline/gezel-connectors-spectral",
  "version": "1.0.7",
  "description": "Runs Gezel's Prismatic (Spectral) connector actions in a separate, sandboxed process.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": ["gezel", "ai", "agents", "local-first", "connectors", "spectral", "prismatic"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/connectors-spectral"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./run-action": "./dist/run-action.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES",
    "vendor/provenance.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:vendor": "node scripts/vendor-component.mjs"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.23.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
