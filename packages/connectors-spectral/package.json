{
  "name": "@bendyline/gezel-connectors-spectral",
  "version": "1.0.0",
  "description": "Off-platform host for Apache-2.0 Prismatic components (the connector `spectral` driver). Keeps the pinned MIT @prismatic-io/spectral SDK + vendored components out of the service process; the service SPAWNS run-action.js in the sandbox, it never imports it.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": ["gezel", "ai", "agents", "local-first", "connectors", "spectral", "prismatic"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/connectors-spectral"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./run-action": "./dist/run-action.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "!dist/**/*.map"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:vendor": "node scripts/vendor-component.mjs"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.23.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
