{
  "name": "@bendyline/gezel-app",
  "version": "0.0.0",
  "private": true,
  "description": "Build a crew of named AI companions with distinct roles and tools, then put them to work on your projects. Gezel stores their conversations, memory, and work on your computer as ordinary files.",
  "license": "MIT",
  "homepage": "https://github.com/bendyline/gezel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/app"
  },
  "author": {
    "name": "Bendyline LLC",
    "email": "support@bendyline.com"
  },
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "build:bundle": "node ../../scripts/build-service-bundle.mjs",
    "build:packaged": "pnpm run build && node ../../scripts/stage-third-party-licenses.mjs && pnpm run build:bundle",
    "dev": "tsup --watch",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests && node --test ../../scripts/native-payload.test.mjs ../../scripts/native-file-manifest.test.mjs ../../scripts/sign-macho-tree.test.mjs ../../scripts/verify-pe-tree.test.mjs ../../scripts/windows-branding-contract.test.mjs ../../scripts/sbom-coverage.test.mjs ../../scripts/prune-foreign-binaries.test.mjs ../../scripts/sharp-compat.test.mjs ../../scripts/stamp-version.test.mjs ../../scripts/release-electron-contract.test.mjs",
    "test:e2e": "playwright test --reporter=line",
    "test:e2e:web": "playwright test --config playwright.web.config.ts --reporter=line",
    "package": "pnpm run build:packaged && electron-builder --publish never",
    "package:mac": "pnpm run build:packaged && electron-builder --mac --publish never",
    "package:win": "pnpm run build:packaged && electron-builder --win --publish never",
    "package:linux": "pnpm run build:packaged && electron-builder --linux --publish never",
    "install-dev-desktop": "node scripts/install-dev-desktop.mjs",
    "uninstall-dev-desktop": "node scripts/install-dev-desktop.mjs --remove",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bendyline/gezel": "workspace:*",
    "@bendyline/gezel-client": "workspace:*",
    "electron-updater": "^6.8.9",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@bendyline/gezel-service": "workspace:*",
    "@bendyline/gezel-ui": "workspace:*",
    "@electron/asar": "^4.2.1",
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "tar": "7.5.21",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
