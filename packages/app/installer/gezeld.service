[Unit]
# systemd unit for the Gezel system service. Installed to
# /etc/systemd/system/gezeld.service by the deb/rpm afterInstall hook
# (see installer/linux/after-install.sh).
#
# Runs at boot, before any user logs in. Owns shared model downloads,
# native-engine residency, and GPU/RAM queues. Electron never connects to
# this broker directly; each account's user daemon verifies and proxies it.
Description=Gezel shared model engine
Documentation=https://github.com/bendyline/gezel
After=network.target

[Service]
Type=simple
User=gezel
Group=gezel
# Private-by-default daemon state. gezeld explicitly widens only runtime
# discovery metadata needed by cross-account user daemons.
UMask=0077
# ELECTRON_RUN_AS_NODE=1 turns the bundled Electron exe into a vanilla
# Node interpreter for this child only — no UI, no Chromium. Saves the
# ~80 MB of bundling a separate Node binary.
Environment=ELECTRON_RUN_AS_NODE=1
Environment=GEZEL_HOME=/var/lib/gezel
# Reserve the canonical machine-service endpoint. User-owned CLI fallbacks use
# runtime-discovered ephemeral ports and therefore cannot block this service.
Environment=GEZEL_PORT=6228
# Service writes a scoped, non-root inference/model-management credential to
# runtime/auth-token with mode 0644. The root token remains process-local;
# the user-daemon bridge keeps this rotating credential out of the renderer.
Environment=GEZEL_SYSTEM_SCOPE=1
# Split-service contract: this account owns native engines, model downloads,
# and resource queues only. Product/project state stays in each user's daemon.
Environment=GEZEL_SERVICE_ROLE=machine-engine
# Public immutable model bundles live outside the daemon's private state
# boundary. Only the `gezel` service identity can write this tree.
Environment=GEZEL_SHARED_ASSETS_DIR=/var/lib/gezel/assets
# The `gezel` system user is created with --no-create-home, so $HOME
# defaults to /home/gezel (which doesn't exist) or /. Tools that derive
# state paths from $HOME — pnpm's store at ~/.local/share/pnpm, npm
# cache at ~/.npm, node's ~/.node-gyp — need a writable home. Point them
# at the same system-scope dir we already own.
Environment=HOME=/var/lib/gezel
# Bundled pnpm script + Node binary. The Electron supervisor sets these in
# its own process env for user-context launches; the system service is
# started by systemd with a clean environment and never sees those, so
# they have to be declared here. Both paths point at the asar-unpacked
# tree inside /opt/Gezel; Node executes pnpm's ordinary JavaScript entry.
Environment=GEZEL_PNPM_PATH=/opt/Gezel/resources/app.asar.unpacked/dist/pnpm-bundle/bin/pnpm.mjs
Environment=GEZEL_NODE_PATH=/opt/Gezel/resources/app.asar.unpacked/dist/node-bundle/node
# Bundled native engines (llama.cpp variants, sd-cpp, whisper.cpp, uv)
# live under /opt/Gezel/resources/app.asar.unpacked/native-bin/. The
# service's native-discovery (packages/service/src/native/discover.ts)
# reads GEZEL_NATIVE_BIN_DIR to find them. Without this systemd starts
# the unit with a clean env, can't find any bundled binary, and
# on-device chat throws "no local engine is available on this machine."
Environment=GEZEL_NATIVE_BIN_DIR=/opt/Gezel/resources/app.asar.unpacked/native-bin
WorkingDirectory=/var/lib/gezel
# gezeld lives at /var/lib/gezel/service/dist/bin/gezeld.js — extracted
# from the shipped tarball by installer/linux/after-install.sh at install
# time. ProtectSystem=full keeps /opt and /usr read-only; ReadWritePaths
# below grants writes to the daemon's data dir.
ExecStart=/opt/Gezel/gezel /var/lib/gezel/service/dist/bin/gezeld.js
Restart=on-failure
RestartSec=5

# Sandboxing — these are conservative defaults that work for our
# loopback-only HTTP service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/gezel
# Shared projects/gezels belong to interactive user daemons. Hide this child
# even though the broker's private home is otherwise writable.
InaccessiblePaths=/var/lib/gezel/shared

[Install]
WantedBy=multi-user.target
