<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    LaunchDaemon for the Gezel system service. Installed to
    /Library/LaunchDaemons/com.bendyline.gezeld.plist by the PKG
    installer's postinstall script (see installer/macos-pkg-scripts/
    postinstall).

    Runs at boot, before any user logs in. Hosts the loopback HTTP
    service that the per-user Electron Gezel.app connects to.

    Why ELECTRON_RUN_AS_NODE=1: the Electron exe inside Gezel.app
    behaves as a plain Node interpreter when this env var is set, so we
    don't need to bundle a separate Node. Electron is signed and
    notarized, so this is a known-good interpreter.

    Why _gezeld and not root: standard daemon hygiene. The _gezeld user
    is a non-login system account created by the PKG postinstall.
    The runtime/auth-token file written by the service is a non-root,
    first-party client credential. It is mode 0o644 so logged-in desktop
    clients can read it; the daemon root token never leaves process memory.
    GEZEL_SYSTEM_SCOPE=1 selects this split runtime policy.
    GEZEL_PORT=6228 reserves the canonical machine-service endpoint; any
    user-owned CLI fallback runs on a discoverable ephemeral port.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bendyline.gezeld</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Gezel.app/Contents/MacOS/Gezel</string>
        <string>/Library/Application Support/Gezel/service/dist/bin/gezeld.js</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ELECTRON_RUN_AS_NODE</key>
        <string>1</string>
        <key>GEZEL_HOME</key>
        <string>/Library/Application Support/Gezel</string>
        <key>GEZEL_PORT</key>
        <string>6228</string>
        <key>GEZEL_SYSTEM_SCOPE</key>
        <string>1</string>
        <key>GEZEL_SHARED_ASSETS_DIR</key>
        <string>/Library/Application Support/Gezel/assets</string>
        <!-- Override the launchd default $HOME of /var/empty (the
             _gezeld user's NFSHomeDirectory). Tools that derive cache
             / state paths from $HOME — pnpm's store at
             ~/.local/share/pnpm, npm cache at ~/.npm, node's
             ~/.node-gyp, etc. — need a writable home, not /var/empty.
             Point them at the same system-scope dir we already own. -->
        <key>HOME</key>
        <string>/Library/Application Support/Gezel</string>
        <!-- Bundled pnpm script + Node binary. The Electron supervisor sets
             these in its own process env for user-context launches; the
             system service is started by launchd with a clean
             environment and never sees those, so they have to be
             declared here. Both paths point inside the installed .app's
             asar-unpacked tree; Node is code-signed and executes pnpm's
             ordinary JavaScript entry directly. The
             postinstall pinning these to /Applications/Gezel.app
             matches how ProgramArguments and GEZEL_UI_DIR are pinned. -->
        <key>GEZEL_PNPM_PATH</key>
        <string>/Applications/Gezel.app/Contents/Resources/app.asar.unpacked/dist/pnpm-bundle/bin/pnpm.mjs</string>
        <key>GEZEL_NODE_PATH</key>
        <string>/Applications/Gezel.app/Contents/Resources/app.asar.unpacked/dist/node-bundle/node</string>
        <!-- Static UI bundle. Lives at app.asar.unpacked/dist/ui/
             inside the .app. The daemon's own findBundledUi searches
             relative to gezeld.js and would land on `…/service/dist/ui`
             (wrong location — the service tree doesn't include a UI
             subtree; UI is shipped separately), so we pin the right
             path here. Without it the system service serves the
             "web UI bundle was not included" placeholder. -->
        <key>GEZEL_UI_DIR</key>
        <string>/Applications/Gezel.app/Contents/Resources/app.asar.unpacked/dist/ui</string>
        <!-- Bundled native engines (llama.cpp Metal, sd-cpp, whisper.cpp,
             uv) live under app.asar.unpacked/native-bin/. The service's
             native-discovery (packages/service/src/native/discover.ts)
             reads GEZEL_NATIVE_BIN_DIR to find them. Without this the
             LaunchDaemon starts with a clean env, can't find any
             bundled binary, and on-device chat throws "no local engine
             is available on this machine." -->
        <key>GEZEL_NATIVE_BIN_DIR</key>
        <string>/Applications/Gezel.app/Contents/Resources/app.asar.unpacked/native-bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>UserName</key>
    <string>_gezeld</string>

    <key>GroupName</key>
    <string>_gezeld</string>

    <!-- Private-by-default daemon state. gezeld explicitly chmods only the
         runtime discovery metadata (scoped client token, port, public cert)
         that desktop clients must read across accounts. Decimal 63 = 077. -->
    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>/Library/Application Support/Gezel/logs/service-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Application Support/Gezel/logs/service-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Library/Application Support/Gezel</string>
</dict>
</plist>
