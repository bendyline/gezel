#!/bin/bash
#
# Gezel PKG postinstall — runs as root after the .app has been copied to
# /Applications/. Sets up the _gezeld system user, the system-scope data
# directory, and bootstraps the LaunchDaemon.
#
# Idempotent: re-runs (e.g. on upgrade or after an interrupted install)
# converge the account, filesystem, service registration, and health state.
# Failures inside this script are surfaced to the installer UI as a
# generic "installation failed". PackageKit may roll back the app payload,
# but script side effects such as users, data directories, and launchd
# overrides persist; every successful rerun must therefore repair them.
#
# Logs go to /var/log/install.log (PKG default) and to stderr (visible
# in the macOS Installer.app's "Show Log" pane).
set -Eeuo pipefail
# Make every installer-created state file private by default. The launchd
# plist applies the same umask to future daemon writes; runtime discovery
# files are explicitly widened by gezeld after creation.
umask 077

DAEMON_USER="_gezeld"
DAEMON_LABEL="com.bendyline.gezeld"
DATA_DIR="/Library/Application Support/Gezel"
SHARED_DIR="/Users/Shared/Gezel"
ASSETS_DIR="${DATA_DIR}/assets"
SERVICE_TREE="${DATA_DIR}/service"
PLIST_DST="/Library/LaunchDaemons/${DAEMON_LABEL}.plist"
PLIST_SRC="/Applications/Gezel.app/Contents/Resources/${DAEMON_LABEL}.plist"
ELECTRON_EXE="/Applications/Gezel.app/Contents/MacOS/Gezel"
UNPACKED_DIR="/Applications/Gezel.app/Contents/Resources/app.asar.unpacked/dist"
EXTRACT_CLI="${UNPACKED_DIR}/extract-service-bundle.js"
MIGRATE_SHARED_CLI="${UNPACKED_DIR}/migrate-legacy-shared.js"
BUNDLE_TARBALL="${UNPACKED_DIR}/service-bundle.tar.gz"
BUNDLE_META="${UNPACKED_DIR}/service-bundle.meta.json"
RUNTIME_PORT="${DATA_DIR}/runtime/port"
RUNTIME_CERT="${DATA_DIR}/runtime/cert.pem"
SERVICE_STDOUT="${DATA_DIR}/logs/service-stdout.log"
SERVICE_STDERR="${DATA_DIR}/logs/service-stderr.log"

report_unhandled_error() {
  status="$1"
  line="$2"
  command="$3"
  trap - ERR
  echo "[gezel postinstall] ERROR: command failed at line ${line} (exit ${status}): ${command}" >&2
  exit "$status"
}

# PackageKit otherwise reports only "an error occurred while running scripts".
# Keep the exact failing line and command in /var/log/install.log so a failed
# install is actionable without reproducing it on the user's machine.
trap 'report_unhandled_error "$?" "$LINENO" "$BASH_COMMAND"' ERR

echo "[gezel postinstall] starting (user=$(whoami))"

assert_not_symlink() {
  path="$1"
  description="$2"
  if [ -L "$path" ]; then
    echo "[gezel postinstall] ERROR: $description is a symlink: $path" >&2
    exit 1
  fi
}

abort_bad_service_identity() {
  echo "[gezel postinstall] ERROR: refusing to use ${DAEMON_USER} as the daemon identity: $1" >&2
  # Quarantine a prior registration before aborting. Otherwise an upgrade on
  # a machine with a colliding human account could leave the old job running
  # while the desktop assumes it will safely fall back.
  launchctl disable "system/${DAEMON_LABEL}" 2>/dev/null || true
  launchctl bootout "system/${DAEMON_LABEL}" 2>/dev/null || true
  exit 1
}

dump_service_diagnostics() {
  launchctl print "system/${DAEMON_LABEL}" >&2 || true
  for log_path in "$SERVICE_STDERR" "$SERVICE_STDOUT"; do
    if [ -f "$log_path" ]; then
      echo "[gezel postinstall] --- tail ${log_path} ---" >&2
      tail -n 80 "$log_path" >&2 || true
    fi
  done
}

wait_for_service_health() {
  health_deadline=$((SECONDS + 60))
  while [ "$SECONDS" -lt "$health_deadline" ]; do
    if launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1 && \
       [ -s "$RUNTIME_PORT" ] && [ -s "$RUNTIME_CERT" ]; then
      runtime_port=$(awk 'NR == 1 { print $1 }' "$RUNTIME_PORT")
      if [[ "$runtime_port" =~ ^[0-9]+$ ]] && \
         [ "$runtime_port" -ge 1 ] && [ "$runtime_port" -le 65535 ]; then
        if health_response=$(
          /usr/bin/curl \
            --fail \
            --silent \
            --show-error \
            --connect-timeout 2 \
            --max-time 3 \
            --cacert "$RUNTIME_CERT" \
            "https://127.0.0.1:${runtime_port}/api/health" 2>/dev/null
        ); then
          if printf '%s\n' "$health_response" |
             grep -Eq '"ok"[[:space:]]*:[[:space:]]*true' &&
             printf '%s\n' "$health_response" |
             grep -Eq '"serviceRole"[[:space:]]*:[[:space:]]*"(machine-engine|legacy-full)"'; then
            echo "[gezel postinstall] service health verified on port ${runtime_port}"
            return 0
          fi
        fi
      fi
    fi
    sleep 1
  done

  echo "[gezel postinstall] ERROR: ${DAEMON_LABEL} did not become healthy within 60 seconds" >&2
  dump_service_diagnostics
  return 1
}

# 1. Create the _gezeld system user/group if missing. macOS reserves
# UIDs 200-400 for daemon users; we pick the next free UID in that
# range. Underscore-prefixed users are conventionally hidden from the
# login screen.
if ! dscl . -read "/Users/${DAEMON_USER}" >/dev/null 2>&1; then
  echo "[gezel postinstall] creating ${DAEMON_USER} system user"
  # Pick an ID unused by either a user or a group. max(user UID)+1 can collide
  # with an existing group or overflow the reserved daemon range.
  used_ids=$({
    dscl . -list /Users UniqueID
    dscl . -list /Groups PrimaryGroupID
  } | awk '$2 >= 200 && $2 < 400 { print $2 }' | sort -un)
  new_uid=""
  for candidate in $(seq 200 399); do
    if ! printf '%s\n' "$used_ids" | grep -qx "$candidate"; then
      new_uid=$candidate
      break
    fi
  done
  if [ -z "$new_uid" ]; then
    echo "[gezel postinstall] ERROR: no unused daemon UID/GID remains in 200-399" >&2
    exit 1
  fi
  dscl . -create "/Groups/${DAEMON_USER}"
  dscl . -create "/Groups/${DAEMON_USER}" PrimaryGroupID "$new_uid"
  dscl . -create "/Groups/${DAEMON_USER}" RealName "Gezel Service"

  dscl . -create "/Users/${DAEMON_USER}"
  dscl . -create "/Users/${DAEMON_USER}" UniqueID "$new_uid"
  dscl . -create "/Users/${DAEMON_USER}" PrimaryGroupID "$new_uid"
  dscl . -create "/Users/${DAEMON_USER}" UserShell /usr/bin/false
  dscl . -create "/Users/${DAEMON_USER}" RealName "Gezel Service"
  dscl . -create "/Users/${DAEMON_USER}" NFSHomeDirectory /var/empty
  dscl . -create "/Users/${DAEMON_USER}" Password "*"
  # Hide from the login screen.
  dscl . -create "/Users/${DAEMON_USER}" IsHidden 1
else
  echo "[gezel postinstall] ${DAEMON_USER} already exists; skipping create"
  # Repair a half-provisioned identity. The group is only ever created in the
  # branch above, so a machine that kept the user but lost the group could
  # never get it back: every reinstall takes this branch, skips the only code
  # that creates a group, and then fails validation. That state is reachable
  # (an interrupted uninstall, or an install predating the paired create) and
  # left users with no recovery short of manual dscl surgery, because
  # uninstall.sh ships inside an app bundle the failed install never wrote.
  #
  # Recreate it from the user's own PrimaryGroupID, and only when that id is
  # actually free. If it is out of range or already owned by another group,
  # minting a group over it would manufacture exactly the shared-GID collision
  # the checks below exist to reject — leave it missing and let them say so.
  if ! dscl . -read "/Groups/${DAEMON_USER}" >/dev/null 2>&1; then
    echo "[gezel postinstall] ${DAEMON_USER} group is missing; attempting repair"
    repair_gid=$(
      dscl . -read "/Users/${DAEMON_USER}" PrimaryGroupID 2>/dev/null |
        awk '$1 ~ /(^|:)PrimaryGroupID:$/ { print $2 }' || true
    )
    repair_gid_owners=$(
      dscl . -list /Groups PrimaryGroupID 2>/dev/null |
        awk -v id="$repair_gid" '$2 == id { count++ } END { print count + 0 }' || true
    )
    if [[ "$repair_gid" =~ ^[0-9]+$ ]] &&
      [ "$repair_gid" -ge 200 ] &&
      [ "$repair_gid" -lt 400 ] &&
      [ "$repair_gid_owners" = "0" ]; then
      dscl . -create "/Groups/${DAEMON_USER}"
      dscl . -create "/Groups/${DAEMON_USER}" PrimaryGroupID "$repair_gid"
      dscl . -create "/Groups/${DAEMON_USER}" RealName "Gezel Service"
      echo "[gezel postinstall] recreated ${DAEMON_USER} group with GID ${repair_gid}"
    else
      echo "[gezel postinstall] cannot safely recreate ${DAEMON_USER} group" \
        "(PrimaryGroupID='${repair_gid}', conflicting groups=${repair_gid_owners:-unknown})" >&2
    fi
  fi
fi

# Validate both new and pre-existing identities. Numeric UID/GID reuse would
# make another local principal indistinguishable from the daemon to POSIX
# ownership checks, so collision or reserved-range drift is installation-fatal.
#
# Every read goes through this helper because dscl exits non-zero for a missing
# record *and* for a missing key on a record that exists. Under
# `set -Eeuo pipefail` a bare `x=$(dscl ... | awk ...)` therefore aborts the
# whole install at the ERR trap, reporting a line number instead of which part
# of the identity is wrong — and PackageKit shows the user only "installation
# failed". Absent values must survive to the named checks below.
#
# macOS 26 renders native attributes as `dsAttrTypeNative:IsHidden: 1` while
# older releases use `IsHidden: 1`, so the key match accepts either label
# without weakening the requirement on the stored value itself.
read_daemon_attribute() {
  dscl . -read "$1" "$2" 2>/dev/null |
    awk -v key="$2" '$1 ~ "(^|:)" key ":$" { print $2 }' || true
}
daemon_uid=$(read_daemon_attribute "/Users/${DAEMON_USER}" UniqueID)
daemon_user_gid=$(read_daemon_attribute "/Users/${DAEMON_USER}" PrimaryGroupID)
daemon_group_gid=$(read_daemon_attribute "/Groups/${DAEMON_USER}" PrimaryGroupID)
daemon_shell=$(read_daemon_attribute "/Users/${DAEMON_USER}" UserShell)
daemon_home=$(read_daemon_attribute "/Users/${DAEMON_USER}" NFSHomeDirectory)
daemon_hidden=$(read_daemon_attribute "/Users/${DAEMON_USER}" IsHidden)
if [ -z "$daemon_uid" ] || [ -z "$daemon_user_gid" ]; then
  abort_bad_service_identity "the dedicated user record is missing or incomplete"
fi
if [ -z "$daemon_group_gid" ]; then
  abort_bad_service_identity "the matching ${DAEMON_USER} group is missing and could not be repaired"
fi
if ! [[ "$daemon_uid" =~ ^[0-9]+$ && "$daemon_user_gid" =~ ^[0-9]+$ && "$daemon_group_gid" =~ ^[0-9]+$ ]]; then
  abort_bad_service_identity "UID/GID identity is incomplete or non-numeric"
fi
# Guarded for the same reason as the reads above: a directory-service failure
# here must reach the collision check as a count, not abort at the ERR trap.
user_id_count=$(
  dscl . -list /Users UniqueID 2>/dev/null |
    awk -v id="$daemon_uid" '$2 == id { count++ } END { print count + 0 }' || true
)
group_id_count=$(
  dscl . -list /Groups PrimaryGroupID 2>/dev/null |
    awk -v id="$daemon_group_gid" '$2 == id { count++ } END { print count + 0 }' || true
)
if [ "$daemon_uid" -lt 200 ] || [ "$daemon_uid" -ge 400 ] || \
   [ "$daemon_uid" -ne "$daemon_user_gid" ] || \
   [ "$daemon_uid" -ne "$daemon_group_gid" ] || \
   [ "${user_id_count:-0}" -ne 1 ] || [ "${group_id_count:-0}" -ne 1 ]; then
  abort_bad_service_identity "UID/GID is shared, mismatched, or outside 200-399"
fi
if [ "$daemon_shell" != "/usr/bin/false" ] || \
   [ "$daemon_home" != "/var/empty" ] || \
   [ "$daemon_hidden" != "1" ]; then
  abort_bad_service_identity "account is login-capable or has unexpected home/visibility metadata"
fi

# Stop the old daemon before changing ownership/modes or replacing its service
# tree. This closes the upgrade race where it could recreate a broadly-readable
# file while the migration was tightening permissions.
launchctl bootout "system/${DAEMON_LABEL}" 2>/dev/null || true
for _ in $(seq 1 30); do
  launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1 || break
  sleep 0.5
done
if launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
  echo "[gezel postinstall] ERROR: ${DAEMON_LABEL} remained loaded after bootout; refusing live state migration" >&2
  exit 1
fi

# Every root pass below over a tree the daemon account can write is safe only
# while nothing runs as that account. Such a pass resolves each path when it
# acts on it, so a live process could swap a checked entry for a link to a
# system file between the check and the chown/chmod — the account parses
# untrusted model files, so it is the one to assume compromised. Bootout ends
# the job; this also ends anything that left its process group.
service_account_running() {
  for id_flag in -U -u; do
    pgrep_status=0
    /usr/bin/pgrep "$id_flag" "$DAEMON_USER" >/dev/null 2>&1 || pgrep_status=$?
    case $pgrep_status in
      0) return 0 ;;
      1) ;;
      *)
        echo "[gezel postinstall] ERROR: cannot list processes running as ${DAEMON_USER} (pgrep exit ${pgrep_status})" >&2
        exit 1
        ;;
    esac
  done
  return 1
}

stop_service_account_processes() {
  for _ in $(seq 1 10); do
    service_account_running || return 0
    /usr/bin/pkill -KILL -U "$DAEMON_USER" 2>/dev/null || true
    /usr/bin/pkill -KILL -u "$DAEMON_USER" 2>/dev/null || true
    sleep 1
  done
  echo "[gezel postinstall] ERROR: processes still run as ${DAEMON_USER}; refusing to repair files that account can change" >&2
  exit 1
}

stop_service_account_processes

# 2. Create and migrate the system-scope data hierarchy. The parent is 0711:
# user daemons can traverse the known runtime path but cannot list private or
# legacy state. runtime alone is 0755; its discovery files are the only
# cross-account state gezeld explicitly publishes.
assert_not_symlink "$DATA_DIR" "Gezel data directory"
assert_not_symlink "$DATA_DIR/runtime" "Gezel runtime directory"
assert_not_symlink "$ASSETS_DIR" "Gezel public asset directory"
assert_not_symlink "$ASSETS_DIR/models" "Gezel shared model directory"
assert_not_symlink "$DATA_DIR/logs" "Gezel logs directory"
assert_not_symlink "$SERVICE_TREE" "Gezel service tree"
mkdir -p "$DATA_DIR/runtime" "$DATA_DIR/logs" "$ASSETS_DIR/models"
assert_not_symlink "$DATA_DIR" "Gezel data directory"
assert_not_symlink "$DATA_DIR/runtime" "Gezel runtime directory"
assert_not_symlink "$ASSETS_DIR" "Gezel public asset directory"
assert_not_symlink "$ASSETS_DIR/models" "Gezel shared model directory"
assert_not_symlink "$DATA_DIR/logs" "Gezel logs directory"
assert_not_symlink "$SERVICE_TREE" "Gezel service tree"

# Compatibility exit for pre-split installs. The old full-product daemon is
# stopped above, so the bundled verifier can atomically move projects/gezels
# out of the broker's private home. Its root marker is published only after
# every entity has moved (or a partial prior run has been byte-verified).
if [ ! -f "$MIGRATE_SHARED_CLI" ]; then
  echo "[gezel postinstall] ERROR: shared-data migration CLI is missing: $MIGRATE_SHARED_CLI" >&2
  exit 1
fi
assert_not_symlink "$SHARED_DIR" "Gezel machine-shared data directory"
# The migration moves private product data into this directory and the
# publishing step below trusts what root placed there, so it must be one root
# created. /Users/Shared is world-writable: any account could have made
# /Users/Shared/Gezel first, and would keep full control of a directory it
# owns. Every release that made it left it root-owned; anything else is
# refused rather than adopted. Because /Users/Shared is sticky, a root-owned
# entry cannot be replaced after this check.
mkdir -m 700 "$SHARED_DIR" 2>/dev/null || true
assert_not_symlink "$SHARED_DIR" "Gezel machine-shared data directory"
if [ ! -d "$SHARED_DIR" ] || [ "$(stat -f %u "$SHARED_DIR")" != 0 ]; then
  echo "[gezel postinstall] ERROR: $SHARED_DIR is not a root-owned directory; refusing to migrate into or publish it. Remove it (after checking what it holds) and reinstall." >&2
  exit 1
fi
echo "[gezel postinstall] migrating legacy projects and gezels into $SHARED_DIR"
# Known duplicate/conflict states are reconciled inside the migration CLI. Any
# remaining non-zero exit means the complete shared root was not published.
# Do not report a successful package install in that state: the account-local
# fallback cannot mount an unmarked root. The CLI rolls back same-volume moves
# before failing, so a rerun starts from the intact legacy product tree.
ELECTRON_RUN_AS_NODE=1 "$ELECTRON_EXE" "$MIGRATE_SHARED_CLI" \
  --source="$DATA_DIR" \
  --dest="$SHARED_DIR"
assert_not_symlink "$SHARED_DIR" "Gezel machine-shared data directory"

# 2b. Extract the shipped service bundle before any recursive repair walk.
# extractBundleIfNeeded reclaims interrupted service.staging-* trees first. If
# PackageKit killed a prior install, doing that cleanup here prevents the
# permission migration below from traversing tens of thousands of doomed files
# before the extractor can remove them.
echo "[gezel postinstall] extracting service bundle"
if [ ! -f "$BUNDLE_TARBALL" ] || [ ! -f "$EXTRACT_CLI" ]; then
  echo "[gezel postinstall] ERROR: shipped bundle missing (tarball=$BUNDLE_TARBALL cli=$EXTRACT_CLI)" >&2
  exit 1
fi
available_kib=$(df -Pk "$DATA_DIR" | awk 'END { print $4 }' || true)
if [[ "$available_kib" =~ ^[0-9]+$ ]] && [ "$available_kib" -lt 10485760 ]; then
  echo "[gezel postinstall] WARNING: only ${available_kib} KiB is free; service extraction may be slow" >&2
fi
extract_started=$SECONDS
ELECTRON_RUN_AS_NODE=1 "$ELECTRON_EXE" "$EXTRACT_CLI" \
  --tarball="$BUNDLE_TARBALL" \
  --meta="$BUNDLE_META" \
  --dest="$SERVICE_TREE" \
  --force
echo "[gezel postinstall] service bundle ready in $((SECONDS - extract_started))s"

# Upgrade migration: remove legacy world/group permissions without following
# symlinks into user-controlled targets, and make the daemon the trusted owner.
# Physical, same-filesystem walks avoid following planted descendant symlinks
# or crossing a mounted tree while privileged ownership/mode changes run.
#
# These passes run as root over trees the daemon account owns. With that
# account's processes gone (above), nothing moves entries while they run; what
# remains is anything it left behind. A symlink is never followed and never
# given a mode or ACL. A regular file with more than one link is left exactly
# as it is: macOS lets any account hard-link a file it does not own, and a
# chown or chmod through that name would change the linked system file.
#
# Product code, interrupted product-code staging trees, and public assets are
# pruned from this private-state pass. The service family is replaced or
# reclaimed above and published below; assets have their own public-mode pass.
# Keeping the actions in one find traversal matters on inode-heavy upgrades.
harden_private_state() {
  find -x "$DATA_DIR" \
    \( -path "$SERVICE_TREE" -o \
       -path "${SERVICE_TREE}.previous" -o \
       -path "${SERVICE_TREE}.staging-*" -o \
       -path "$ASSETS_DIR" \) -prune -o \
    \( -type f -links +1 \) -prune -o \
    -exec chown -h "${DAEMON_USER}:${DAEMON_USER}" {} + \
    ! -type l -exec chmod -N {} + \
    -exec chmod go-rwx {} +
  chmod 711 "$DATA_DIR"
  chmod 755 "$DATA_DIR/runtime"
  chmod 700 "$DATA_DIR/logs"
}

# Shared model bundles are the sole public data subtree. Refuse links before
# widening modes so an elevated upgrade can never publish an external target.
harden_shared_assets() {
  if find -x "$ASSETS_DIR" -type l -print -quit | grep -q .; then
    echo "[gezel postinstall] ERROR: shared asset store contains a symlink" >&2
    exit 1
  fi
  find -x "$ASSETS_DIR" \
    \( -type f -links +1 \) -prune -o \
    -exec chown -h "${DAEMON_USER}:${DAEMON_USER}" {} + \
    ! -type l -exec chmod -N {} + \
    \( -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} + \)
}

echo "[gezel postinstall] hardening private machine state"
private_hardening_started=$SECONDS
harden_private_state
echo "[gezel postinstall] private machine state hardened in $((SECONDS - private_hardening_started))s"
echo "[gezel postinstall] normalizing shared model store"
assets_hardening_started=$SECONDS
harden_shared_assets
echo "[gezel postinstall] shared model store normalized in $((SECONDS - assets_hardening_started))s"

# Shared product data is intentionally writable by interactive local accounts;
# the engine broker never opens it. The sticky root protects the root-owned
# trust marker and scope directories from replacement, while inherited ACLs
# keep new nested files collaborative across accounts.
#
# Root never walks this collaborative tree. Every local account can rename
# anything inside a scope directory, so a root pass over it — chmod by path,
# `find -exec` included — could be steered through a swapped-in symlink or
# hard link onto a system file (an everyone-writable /etc/sudoers, say). Nested
# directories stay non-sticky on purpose: collaborating accounts replace each
# other's files. Content they create needs no repair; it inherits the
# everyone ACE below when it is created.
#
# Root touches only the root itself and the root-owned scope directories and
# marker directly inside its sticky top level — entries no other account can
# move — plus entities the migration has just placed, via publish_migrated_entity.
SHARED_EVERYONE_ACE="everyone allow read,write,execute,append,readattr,writeattr,readextattr,writeextattr,readsecurity,file_inherit,directory_inherit"

# A migrated entity arrives private: owned by the daemon account (moved from its
# home) or by root (copied across volumes), with no group/other access. Nothing
# but root can reach inside once its ACL is cleared, so its subtree can be
# walked by path — provided the walk is anchored to the directory rather than
# to its name, which any local account can rename. The subshell's `cd` pins the
# directory; everything after it is relative to that directory, and access
# opens only with the final changes to `.`. Published entities (open, or owned
# by anyone else) are never walked again.
publish_migrated_entity() (
  scope_dir=$1
  name=$2
  case $name in
    '' | [!A-Za-z0-9@]* | *[!A-Za-z0-9@._-]*) exit 0 ;;
  esac
  cd -P -- "$scope_dir/$name" 2>/dev/null || exit 0
  [ "$(pwd -P)" = "$shared_physical/${scope_dir##*/}/$name" ] || exit 0
  owner_mode=$(stat -f '%u %Lp' .) || exit 0
  # shellcheck disable=SC2086
  set -- $owner_mode
  case $1 in 0 | "$daemon_uid") ;; *) exit 0 ;; esac
  case $2 in *00) ;; *) exit 0 ;; esac
  chmod -N .
  echo "[gezel postinstall] publishing migrated shared entity ${scope_dir##*/}/$name"
  if find -x . -type f -links +1 -print -quit | grep -q .; then
    echo "[gezel postinstall] WARNING: hard-linked files in ${scope_dir##*/}/$name stay private" >&2
  fi
  find -x . -mindepth 1 \( -type l -o \( -type f -links +1 \) \) -prune -o \
    -exec chmod -N {} + \
    -exec chmod a+rwX,ug-s {} + \
    -type d -exec chmod +a "$SHARED_EVERYONE_ACE" {} +
  chmod a+rwX .
  chmod +a "$SHARED_EVERYONE_ACE" .
)

publish_shared_data() {
  shared_physical=$(cd -P -- "$SHARED_DIR" && pwd -P)
  chmod -N "$SHARED_DIR"
  chmod 1777 "$SHARED_DIR"
  chmod +a "$SHARED_EVERYONE_ACE" "$SHARED_DIR"
  # The shared root is for interactive user daemons, not the engine identity.
  # Put this inherited deny first; root still performs future installer repairs.
  chmod +a# 0 "${DAEMON_USER} deny list,search,read,write,execute,append,delete,delete_child,readattr,writeattr,readextattr,writeextattr,readsecurity,file_inherit,directory_inherit" "$SHARED_DIR"
  for scope in projects gezels; do
    scope_dir="$SHARED_DIR/$scope"
    if [ ! -e "$scope_dir" ] && [ ! -L "$scope_dir" ]; then
      continue
    fi
    if [ -L "$scope_dir" ] || [ ! -d "$scope_dir" ] || [ "$(stat -f %u "$scope_dir")" != 0 ]; then
      echo "[gezel postinstall] WARNING: leaving $scope_dir unchanged: it is not a root-owned directory" >&2
      continue
    fi
    chmod -N "$scope_dir"
    chmod a+rwX "$scope_dir"
    chmod +a "$SHARED_EVERYONE_ACE" "$scope_dir"
    for entity in "$scope_dir"/*; do
      if [ -e "$entity" ] || [ -L "$entity" ]; then
        publish_migrated_entity "$scope_dir" "${entity##*/}"
      fi
    done
  done
  shared_marker="$SHARED_DIR/.gezel-machine-shared-v1.json"
  if [ -L "$shared_marker" ] || [ ! -f "$shared_marker" ] ||
    [ "$(stat -f '%u %l' "$shared_marker")" != "0 1" ]; then
    echo "[gezel postinstall] ERROR: $shared_marker is not a root-owned regular file" >&2
    exit 1
  fi
  chown root:wheel "$shared_marker"
  chmod 644 "$shared_marker"
}

publish_shared_data

# Invalidate legacy root-equivalent discovery material before making runtime
# traversable. The replacement auth-token is a scoped first-party credential.
rm -f \
  "$DATA_DIR/runtime/auth-token" \
  "$DATA_DIR/runtime/web-ui-token" \
  "$DATA_DIR/runtime/port" \
  "$DATA_DIR/runtime/pid" \
  "$DATA_DIR/runtime/cert.pem" \
  "$DATA_DIR/runtime/cert-fingerprint" \
  "$DATA_DIR/runtime/service-role" \
  "$DATA_DIR/runtime/lock"

# Readable, not private. This tree is the only thing under $DATA_DIR that is not
# the daemon's private state: it is product code, the exact bytes of the
# world-readable tarball inside /Applications/Gezel.app that produced it.
# Publishing it lets each account's user daemon execute this copy instead of
# unpacking a byte-identical second one into its own home — one ~33k-file
# extraction per machine rather than one per account (see
# supervisor/shared-service-tree.ts). $DATA_DIR stays 0711, so the directory is
# reachable by path but not listable.
#
# `go=u-w` grants group/other exactly what the owner has, minus write, so
# executables keep their exec bits and write access stays root's alone. Every
# account's daemon executes this tree, so it must not belong to the daemon
# account either: that account parses untrusted model files, and a tree it
# owned was one it could rewrite under all of them. The supervisor refuses to
# adopt a tree root does not own. The extractor created it as root in a private
# staging directory and nothing runs as the daemon account now, so this pass is
# on a tree no one else can change; stripping ACLs removes any it inherited from
# the daemon-owned home.
publish_service_tree() {
  find -x "$SERVICE_TREE" \
    -exec chown -h root:wheel {} + \
    ! -type l -exec chmod -N {} + \
    -exec chmod go=u-w {} +
}

echo "[gezel postinstall] publishing service tree"
service_publish_started=$SECONDS
publish_service_tree
echo "[gezel postinstall] service tree published in $((SECONDS - service_publish_started))s"

# 3. Install the LaunchDaemon plist (root:wheel 644 — Apple convention).
if [ ! -f "$PLIST_SRC" ]; then
  echo "[gezel postinstall] ERROR: plist missing at $PLIST_SRC" >&2
  exit 1
fi
cp "$PLIST_SRC" "$PLIST_DST"
chown root:wheel "$PLIST_DST"
chmod 644 "$PLIST_DST"

# 4. Enable, bootstrap, and start the already-stopped service.
#
# Idempotency notes — this whole block has to survive being run twice
# in one install transaction. macOS PackageKit runs postinstall a
# second time on upgrade-over-existing installs (the "old version
# cleanup" pass), and that second pass would otherwise race against
# the already-bootstrapped service from the first pass.
#
# `launchctl bootout` returns before the service has fully exited the
# launchd domain; calling `bootstrap` immediately afterward races and
# returns `5: Input/output error`. We poll `print` until the service
# is gone before bootstrapping.
#
# `bootstrap` itself can also fail benignly if another concurrent
# install path has already loaded the same plist — in that case the
# desired end state (service is loaded) is already true, so we treat
# it as success rather than failing the install transaction.
#
# A prior safety abort deliberately persists `launchctl disable`. Clear that
# quarantine only now, after the daemon identity, private data tree, service
# bundle, and plist have all passed validation. `bootstrap` refuses a disabled
# service, so enable must precede it for interrupted-install recovery to work.
launchctl enable "system/${DAEMON_LABEL}"
bootstrap_err=$(launchctl bootstrap system "$PLIST_DST" 2>&1) || {
  if launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
    echo "[gezel postinstall] bootstrap reported '${bootstrap_err}' but service is loaded; continuing"
  else
    echo "[gezel postinstall] bootstrap failed: ${bootstrap_err}" >&2
    exit 1
  fi
}

kickstart_err=$(launchctl kickstart -k "system/${DAEMON_LABEL}" 2>&1) || {
  echo "[gezel postinstall] kickstart reported '${kickstart_err}'; waiting for health" >&2
}
wait_for_service_health

echo "[gezel postinstall] GezelService installed and started."
exit 0
