{
  "name": "@bendyline/gezel-service",
  "version": "0.1.0",
  "description": "The Gezel daemon: HTTP API, task runner, sandbox, agent runtime.",
  "license": "MIT",
  "keywords": ["gezel", "ai", "agents", "local-first", "daemon", "server", "llm"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/service"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gezeld": "./dist/bin/gezeld.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./handboek": {
      "types": "./dist/handboek.d.ts",
      "import": "./dist/handboek.js"
    },
    "./dist/bin/gezeld.js": "./dist/bin/gezeld.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "postinstall.mjs",
    "!dist/**/*.map",
    "!dist/**/__pycache__",
    "!dist/**/*.pyc",
    "!dist/**/*_test.py",
    "!dist/**/*_modeltest.py"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "node ./postinstall.mjs",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@bendyline/gezel": "workspace:*",
    "@bendyline/gezel-client": "workspace:*",
    "@bendyline/gezel-catalog": "workspace:*",
    "@bendyline/gezel-connectors-spectral": "workspace:*",
    "@bendyline/gezel-mcp": "workspace:*",
    "@bendyline/gezel-plugin-sdk": "workspace:*",
    "@bendyline/gezel-script-stdlib": "workspace:*",
    "@bendyline/gezel-sdk": "workspace:*",
    "@bendyline/squisq": "2.7.0",
    "@bendyline/squisq-cli": "2.5.2",
    "@bendyline/squisq-formats": "2.4.1",
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@octokit/rest": "^22.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.6.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "hono": "4.12.34",
    "imapflow": "^1.4.8",
    "mailparser": "^3.9.14",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.61.1",
    "selfsigned": "^5.5.0",
    "sqlite-vec": "^0.1.9",
    "tar": "7.5.21",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^6.0.3",
    "undici": "8.9.0",
    "web-tree-sitter": "^0.25.10",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "kokoro-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@github/copilot-sdk": "^1.0.7",
    "@huggingface/transformers": "^3.8.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "kokoro-js": "^1.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
