{
  "name": "@bendyline/gezel-cli",
  "version": "1.0.3",
  "description": "The `gezel` command-line tool.",
  "license": "MIT",
  "keywords": ["gezel", "ai", "agents", "local-first", "cli", "terminal", "tui"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/cli"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "gezel": "./dist/bin/gezel.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": ["dist", "!dist/**/*.map"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@bendyline/gezel": "workspace:*",
    "@bendyline/gezel-app-sdk": "workspace:*",
    "@bendyline/gezel-catalog": "workspace:*",
    "@bendyline/gezel-client": "workspace:*",
    "@bendyline/gezel-service": "workspace:*",
    "@bendyline/squisq": "2.7.1",
    "@bendyline/squisq-formats": "2.4.3",
    "@bendyline/squisq-react": "2.7.1",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
