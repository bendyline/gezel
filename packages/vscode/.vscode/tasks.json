{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "label": "npm: build",
      "detail": "Bundle the extension host + webview bridge with tsup."
    },
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "group": "build",
      "label": "npm: dev",
      "detail": "tsup --watch — rebuilds on change. Reload the Extension Dev Host (Ctrl+R / Cmd+R) to pick up changes.",
      "problemMatcher": {
        "owner": "tsup",
        "pattern": [
          {
            "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "code": 4,
            "message": 5
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Build start",
          "endsPattern": "Build success"
        }
      }
    },
    {
      "type": "npm",
      "script": "typecheck",
      "group": "test",
      "problemMatcher": ["$tsc"],
      "label": "npm: typecheck"
    }
  ]
}
