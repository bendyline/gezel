{
  "name": "@bendyline/gezel-mcp",
  "version": "1.0.0",
  "description": "Gezel MCP server — gives agents access to memory, workspace, artifacts, and tools.",
  "license": "MIT",
  "keywords": ["gezel", "ai", "agents", "local-first", "mcp", "model-context-protocol", "tools"],
  "homepage": "https://github.com/bendyline/gezel",
  "bugs": {
    "url": "https://github.com/bendyline/gezel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendyline/gezel.git",
    "directory": "packages/mcp"
  },
  "author": {
    "name": "Bendyline",
    "email": "support@bendyline.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gezel-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lint-contracts": {
      "types": "./dist/lint-contracts.d.ts",
      "import": "./dist/lint-contracts.js"
    },
    "./dist/server.js": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "!dist/**/*.map"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@bendyline/gezel": "workspace:*",
    "@bendyline/gezel-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  }
}
